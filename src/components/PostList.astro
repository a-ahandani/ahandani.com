---
import { formatDate, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <a class="post-row" href={`/posts/${post.id}`}>
          <time class="post-date" datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
          <span class="post-main">
            <span class="post-title-link">{post.data.title}</span>
            {post.data.excerpt && <span class="post-excerpt">{post.data.excerpt}</span>}
          </span>
        </a>
      </li>
    ))
  }
</ul>
