---
import Icon from './Icon.astro';

interface Item {
  name: string;
  url: string;
  role?: string;
  years: string;
  description: string;
  post?: string | null;
}

interface Props {
  id: string;
  label: string;
  items: Item[];
  /** Name links to the item's post; the website gets a link icon beside the year. */
  linkIcon?: boolean;
}

const { id, label, items, linkIcon = false } = Astro.props;
---

<section class="name-list" aria-labelledby={`${id}-label`}>
  <h2 id={`${id}-label`} class="eyebrow">{label}</h2>
  <ul class="work-list">
    {
      items.map((item) => (
        <li>
          <span class="work-name">
            {linkIcon ? (
              item.post ? <a href={`/posts/${item.post}`}>{item.name}</a> : item.name
            ) : item.url ? (
              <a href={item.url} target="_blank" rel="noopener">
                {item.name}
              </a>
            ) : (
              item.name
            )}
          </span>
          <span class="work-detail">
            {item.role && <span class="work-role">{item.role}</span>}
            <span class="work-desc">{item.description}</span>
          </span>
          <span class="work-years">
            {item.years}
            {linkIcon && item.url && (
              <a class="work-link" href={item.url} target="_blank" rel="noopener" aria-label={`${item.name} website`} title={`${item.name} website`}>
                <Icon name="link" size={14} />
              </a>
            )}
          </span>
        </li>
      ))
    }
  </ul>
</section>
