---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

const home = await getEntry('home', 'home');
if (!home) throw new Error('Missing src/content/site/home.mdoc');
const { Content } = await render(home);
const posts = (await getPosts()).slice(0, 5);
---

<Base>
  <section class="board">
    <article class="letter">
      <header class="letter-head">
        <h1 class="letter-name">{home.data.greeting}</h1>
      </header>
      <div class="letter-body">
        <Content />
      </div>
    </article>

    <section class="home-writing" aria-labelledby="writing-label">
      <div class="home-writing-head">
        <h2 id="writing-label" class="eyebrow">Writing</h2>
        <a class="text-link" href="/posts">All posts <Icon name="arrow-right" size={14} /></a>
      </div>
      <PostList posts={posts} />
    </section>
  </section>
</Base>
